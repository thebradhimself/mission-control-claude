# Mission Control Environment Variables
# Copy this file to .env.local and fill in values as needed.

# ─── API Authentication ─────────────────────────────────────────────────────
# Set a secret token to protect API endpoints from unauthorized access.
# When not set, all API requests pass through (suitable for localhost-only use).
#
# Generate a token with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Both variables must match. MC_API_TOKEN is used server-side (middleware),
# NEXT_PUBLIC_MC_API_TOKEN is used client-side (browser fetch calls).
#
# MC_API_TOKEN=your-secret-token-here
# NEXT_PUBLIC_MC_API_TOKEN=your-secret-token-here

# ─── AI Chat Backend ────────────────────────────────────────────────────────
# Which backend powers the project chat (Send → /api/ai/chat). Options:
#
#   anthropic-api    Default. Uses @anthropic-ai/sdk with ANTHROPIC_API_KEY.
#   claude-code-cli  Shells out to the local `claude` CLI. Reuses your
#                    `claude login` session (no API key needed when logged in).
#   codex-cli        Shells out to the local `codex` CLI. Reuses your
#                    `codex login` ChatGPT session by default.
#
# MISSION_CONTROL_AI_PROVIDER=anthropic-api
# MISSION_CONTROL_AI_MODEL=claude-sonnet-4-6
#
# For anthropic-api:
# ANTHROPIC_API_KEY=
#
# For claude-code-cli (optional — auto-detected on PATH otherwise):
# MISSION_CONTROL_CLAUDE_BINARY=/opt/homebrew/bin/claude
#
# For codex-cli (optional):
# MISSION_CONTROL_CODEX_BINARY=/opt/homebrew/bin/codex
# Set to 1 to forward OPENAI_API_KEY to codex (overrides ChatGPT login):
# MISSION_CONTROL_CODEX_PASS_OPENAI_KEY=

# ─── Future ─────────────────────────────────────────────────────────────────
# GITHUB_TOKEN=
# DATABASE_URL=
